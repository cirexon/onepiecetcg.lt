{
  "name": "onepiecetcg-lt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:rules": "firebase emulators:exec --only firestore --project demo-onepiecetcg \"vitest run --config vitest.rules.config.ts\"",
    "test:browser": "playwright test",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts",
    "backup:firestore": "node scripts/firestore-backup.mjs backup",
    "backup:verify": "node scripts/firestore-backup.mjs verify",
    "backup:restore": "node scripts/firestore-backup.mjs restore",
    "notices": "node scripts/generate-notices.mjs",
    "check:release": "npm run audit:prod && npm test && npm run build && npm run test:browser && npm run test:rules",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
